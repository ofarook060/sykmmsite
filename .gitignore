# Composer dependencies (regenerated via 'composer install')
/vendor/
composer.lock

# System & Application Temporary Files
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/debugbar/*

# Environment variables (contains sensitive database and API passwords)
.env
env

# IDE / Development Configuration Files
.vscode/
.idea/
.phpunit.cache
phpunit.xml
.php-cs-fixer.php

# Operating System Files
.DS_Store
Thumbs.db

